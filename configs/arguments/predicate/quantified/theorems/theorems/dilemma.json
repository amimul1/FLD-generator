          "(x): {B}x -> {D}x"
      ],
      "conclusion": "(x): (¬{A}x v ¬{B}x)"
  },




  {
      "id": "predicate.universal_theorem.bidirectional_dilemma",
      "premises": [
          "(x): ({A}x v ¬{D}x)",
