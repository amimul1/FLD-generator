      "id": "predicate.universal_theorem.syllogism",
      "premises": [
          "(x): {A}x -> {B}x",
          "(x): {B}x -> {C}x"
      ],
      "conclusion": "(x): {A}x -> {C}x"
  },


  {
      "id": "predicate.universal_theorem.disjunctive_syllogism",
